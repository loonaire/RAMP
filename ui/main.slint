import { Button, CheckBox, ComboBox, LineEdit, ListView } from "std-widgets.slint";

export struct ModuleInfo {
    name: string,
    pid_text: string,
    port_text: string,
    status_brush: brush,
    status_text: string,
    status_fg: brush,
    action_text: string,
    admin_enabled: bool,
    start_enabled: bool,
}

export struct LogLine {
    time: string,
    module: string,
    text: string,
    color: brush,
}

export component MainWindow inherits Window {
    title: "RAMP Control Panel";
    width: 710px;
    height: 480px;

    in property <[ModuleInfo]> modules;
    in property <[LogLine]> logs;
    in property <string> basedir;

    in property <string> update-badge;
    in property <bool> update-busy;

    callback start_stop(int);
    callback admin(int);
    callback open_logs(int);
    callback open_config(int);
    callback do_explorer();
    callback do_settings();
    callback do_quit();
    callback do_updates();
    callback do_about();

    public function scroll-to-bottom() {
        log-list.content-y = Math.min(0px, log-list.visible-height - log-list.content-height);
    }

    MenuBar {
        Menu {
            title: "&File";
            MenuItem { title: "Explorer"; activated => { root.do_explorer(); } }
            MenuItem { title: "Settings"; activated => { root.do_settings(); } }
            MenuSeparator {}
            MenuItem { title: "Quit"; activated => { root.do_quit(); } }
        }
        Menu {
            title: root.update-busy ? "Checking..." : (root.update-badge == "" ? "Updates" : "Updates: " + root.update-badge);
            MenuItem {
                title: "Open update window";
                enabled: !root.update-busy;
                activated => { root.do_updates(); }
            }
        }
        Menu {
            title: "&Help";
            MenuItem { title: "About RAMP..."; activated => { root.do_about(); } }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: #33363f;
            background: #262832;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Rectangle {
                    height: 16px;
                    HorizontalLayout {
                        x: 14px; y: 0px;
                        width: parent.width - 28px;
                        spacing: 6px;
                        Text { width: 100px; text: "MODULE"; color: #8a8f98; font-size: 10px; }
                        Text { width: 80px; text: "PID(S)"; color: #8a8f98; font-size: 10px; }
                        Text { width: 120px; text: "PORT(S)"; color: #8a8f98; font-size: 10px; }
                        Text { width: 80px; text: "STATUS"; color: #8a8f98; font-size: 10px; horizontal-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                for m[idx] in modules: Rectangle {
                    height: 30px;
                    Rectangle {
                        x: 0px; y: 0px; width: 3px; height: 100%;
                        border-radius: 2px;
                        background: m.status_brush;
                    }
                    row-layout := HorizontalLayout {
                        x: 14px; y: 3px;
                        width: parent.width - 28px;
                        spacing: 6px;
                        Text { width: 100px; text: m.name; font-size: 14px; vertical-alignment: center; }
                        Text { width: 80px; text: m.pid_text; font-size: 12px; color: #c8ccd4; vertical-alignment: center; }
                        Text { width: 120px; text: m.port_text; font-size: 12px; color: #c8ccd4; vertical-alignment: center; }
                        Rectangle {
                            width: 80px;
                            height: 22px;
                            y: (row-layout.height - 22px) / 2;
                            Rectangle {
                                width: st_txt.width + 25px;
                                height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: m.status_brush;
                                st_txt := Text {
                                    text: m.status_text;
                                    color: m.status_fg;
                                    font-size: 10px;
                                    x: parent.width - self.width - 7px;
                                    y: (parent.height - self.height) / 2;
                                }
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: m.status_fg;
                                    x: st_txt.x - 11px;
                                    y: (parent.height - 6px) / 2;
                                }
                            }
                        }
                        Button { text: m.action_text; height: 24px; enabled: m.start_enabled; clicked => { root.start_stop(idx); } }
                        Button { text: "Admin"; height: 24px; enabled: m.admin_enabled; clicked => { root.admin(idx); } }
                        Button { text: "Config"; height: 24px; clicked => { root.open_config(idx); } }
                        Button { text: "Logs"; height: 24px; clicked => { root.open_logs(idx); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 8px;
                    padding-bottom: 4px;
                    Text { text: "LOG"; color: #8a8f98; font-size: 10px; }
                }
                log-list := ListView {
                    for log in logs: Rectangle {
                        height: 18px;
                        log-layout := HorizontalLayout {
                            x: 10px; y: 1px;
                            width: parent.width - 26px;
                            spacing: 8px;
                            Text { text: log.time; color: #6f747d; font-size: 11px; font-family: "Consolas"; }
                            Text { text: "[" + log.module + "]"; color: #6aa3ff; font-size: 11px; font-family: "Consolas"; }
                            Text { text: log.text; color: log.color; font-size: 11px; font-family: "Consolas"; horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 10px;
        }
    }
}

export component ConfigWindow inherits Window {
    title: "Settings";
    width: 480px;
    height: 440px;

    in-out property <string> apache-port;
    in-out property <string> apache-ssl-port;
    in-out property <string> mysql-port;
    in-out property <bool> check-ports;
    in-out property <bool> show-debug;
    in-out property <string> editor;
    in-out property <string> browser;

    callback save();
    callback cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text { text: "Ports"; color: #8a8f98; font-size: 11px; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Apache:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.apache-port; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Apache SSL:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.apache-ssl-port; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "MySQL:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.mysql-port; }
        }

        Text { text: "Checks"; color: #8a8f98; font-size: 11px; }
        CheckBox { text: "Check default ports at startup"; checked <=> root.check-ports; }
        CheckBox { text: "Show debug messages in log"; checked <=> root.show-debug; }

        Text { text: "External tools"; color: #8a8f98; font-size: 11px; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Editor:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.editor; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Browser (empty = default):"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.browser; }
        }

        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Cancel"; clicked => { root.cancel(); } }
            Button { text: "Save"; clicked => { root.save(); } }
        }
    }
}

export struct UpdateInfo {
    name: string,
    from-ver: string,
    targets: [string],
    sel: int,
    size: string,
    note: string,
    updatable: bool,
    restorable: bool,
    error: string,
}

export component UpdateWindow inherits Window {
    title: "Component Updates";
    width: 680px;
    height: 430px;

    in property <[UpdateInfo]> rows;
    in property <bool> busy;
    in-out property <bool> allow-major;
    in property <string> status;

    callback check-now();
    callback do-apply(int);
    callback do-restore(int);
    callback close-win();
    callback set-target(int, int);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text { text: "Component Updates"; font-size: 14px; font-weight: 600; }
        Text {
            text: "Archives only, never installers. Each swap is checksum-verified, keeps a backup, and is rolled back on failure.";
            color: #6f747d;
            font-size: 10px;
        }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: 16px;
                    HorizontalLayout {
                        x: 10px; y: 0px;
                        width: parent.width - 20px;
                        spacing: 8px;
                        Text { width: 70px; text: "COMPONENT"; color: #8a8f98; font-size: 10px; }
                        Text { width: 62px; text: "INSTALLED"; color: #8a8f98; font-size: 10px; }
                        Rectangle { horizontal-stretch: 2; Text { text: "TARGET VERSION"; color: #8a8f98; font-size: 10px; } }
                        Text { width: 56px; text: "SIZE"; color: #8a8f98; font-size: 10px; }
                        Rectangle { horizontal-stretch: 1; Text { text: "STATUS"; color: #8a8f98; font-size: 10px; } }
                    }
                }
                ListView {
                    for r[idx] in rows: Rectangle {
                        height: 42px;
                        HorizontalLayout {
                            x: 10px; y: 8px;
                            width: parent.width - 20px;
                            spacing: 8px;
                            Text { text: r.name; width: 70px; font-size: 13px; vertical-alignment: center; }
                            Text {
                                width: 62px;
                                font-size: 12px;
                                font-family: "Consolas";
                                vertical-alignment: center;
                                text: r.from-ver;
                                color: #9aa0aa;
                            }
                            Rectangle {
                                horizontal-stretch: 2;
                                ComboBox {
                                    visible: r.updatable;
                                    x: 0px;
                                    y: (parent.height - self.height) / 2;
                                    width: Math.min(parent.width, 250px);
                                    model: r.targets;
                                    current-index: r.sel;
                                    enabled: !root.busy;
                                    selected(v) => { root.set-target(idx, self.current-index); }
                                }
                                Text {
                                    visible: !r.updatable;
                                    text: r.error != "" ? r.error : "up to date";
                                    font-size: 12px;
                                    color: r.error != "" ? #ff5c5c : #9aa0aa;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                            Text { text: r.size; width: 56px; font-size: 11px; color: #9aa0aa; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    text: r.note;
                                    font-size: 10px;
                                    color: #8a8f98;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                            Button {
                                text: "Update";
                                height: 24px;
                                enabled: r.updatable && !root.busy;
                                clicked => { root.do-apply(idx); }
                            }
                            Button {
                                text: "Restore";
                                height: 24px;
                                enabled: r.restorable && !root.busy;
                                clicked => { root.do-restore(idx); }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #262832;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                CheckBox { text: "Offer other release lines in the target list"; checked <=> root.allow-major; }
                Text { text: root.status; font-size: 11px; color: #9aa0aa; horizontal-stretch: 1; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Check Again"; height: 26px; enabled: !root.busy; clicked => { root.check-now(); } }
            Button { text: "Close"; height: 26px; clicked => { root.close-win(); } }
        }
    }
}

export struct FileRow {
    label: string,
    path: string,
    is-dir: bool,
    exists: bool,
}

export component FileWindow inherits Window {
    title: "RAMP Files";
    width: 520px;
    height: 380px;

    in property <string> heading;
    in property <[FileRow]> rows;
    callback open-row(int);
    callback close_win();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text { text: root.heading; font-size: 14px; font-weight: 600; }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            ListView {
                for r[idx] in rows: Rectangle {
                    height: 26px;
                    r-layout := HorizontalLayout {
                        x: 8px; y: 4px;
                        width: parent.width - 20px;
                        spacing: 8px;
                        Text {
                            text: r.is-dir ? "[DIR]" : (r.exists ? "[FILE]" : "[MISSING]");
                            width: 62px;
                            font-size: 10px;
                            font-family: "Consolas";
                            color: r.exists ? (r.is-dir ? #d8b45a : #9aa0aa) : #ff5c5c;
                        }
                        Text { text: r.label; font-size: 12px; }
                        Text { text: r.path; font-size: 10px; color: #6f747d; horizontal-stretch: 1; }
                    }
                    TouchArea {
                        clicked => { root.open-row(idx); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Click a row to open it"; color: #6f747d; font-size: 10px; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close_win(); } }
        }
    }
}



export component AboutWindow inherits Window {
    title: "About RAMP Control Panel";
    width: 340px;
    height: 230px;

    in property <string> app-version;

    callback close_it();

    VerticalLayout {
        padding: 18px;
        spacing: 7px;
        Rectangle { horizontal-stretch: 1; }
        Text { text: "RAMP Control Panel"; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
        Rectangle { height: 10px; }
        Text { text: root.app-version; horizontal-alignment: center; }
        Text { text: "by Loonaire"; horizontal-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            Button { text: "Close"; clicked => { root.close_it(); } }
        }
    }
}
