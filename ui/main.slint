import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct ModuleInfo {
    name: string,
    pid_text: string,
    port_text: string,
    status_brush: brush,
    status_text: string,
    status_fg: brush,
    action_text: string,
    admin_enabled: bool,
    start_enabled: bool,
}

export struct LogLine {
    time: string,
    module: string,
    text: string,
    color: brush,
}

export component MainWindow inherits Window {
    title: "RAMP Control Panel";
    width: 690px;
    height: 480px;
    icon: @image-url("../assets/logo.png");

    in property <[ModuleInfo]> modules;
    in property <[LogLine]> logs;
    in property <string> basedir;

    // The ports column only ever holds "80, 443", so a fixed 120px left a hole
    // before the status pill. Rust sizes it to the widest list it has to show.
    in property <length> port-col-width: 60px;

    in property <string> update-badge;
    in property <bool> update-busy;

    callback start_stop(int);
    callback admin(int);
    callback open_logs(int);
    callback open_config(int);
    callback do_explorer();
    callback do_settings();
    callback do_quit();
    callback do_updates();
    callback do_about();

    public function scroll-to-bottom() {
        log-list.content-y = Math.min(0px, log-list.visible-height - log-list.content-height);
    }

    MenuBar {
        Menu {
            title: "&File";
            MenuItem { title: "Explorer"; activated => { root.do_explorer(); } }
            MenuItem { title: "Settings"; activated => { root.do_settings(); } }
            MenuSeparator {}
            MenuItem { title: "Quit"; activated => { root.do_quit(); } }
        }
        Menu {
            title: root.update-busy ? "Checking..." : (root.update-badge == "" ? "Updates" : "Updates: " + root.update-badge);
            MenuItem {
                title: "Open update window";
                enabled: !root.update-busy;
                activated => { root.do_updates(); }
            }
        }
        Menu {
            title: "&Help";
            MenuItem { title: "About RAMP..."; activated => { root.do_about(); } }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: #33363f;
            background: #262832;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Rectangle {
                    height: 16px;
                    HorizontalLayout {
                        x: 14px; y: 0px;
                        width: parent.width - 28px;
                        spacing: 6px;
                        Text { width: 100px; text: "MODULE"; color: #8a8f98; font-size: 10px; }
                        Text { width: 80px; text: "PID(S)"; color: #8a8f98; font-size: 10px; }
                        Text { width: root.port-col-width; text: "PORT(S)"; color: #8a8f98; font-size: 10px; }
                        Text { width: 80px; text: "STATUS"; color: #8a8f98; font-size: 10px; horizontal-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                for m[idx] in modules: Rectangle {
                    height: 30px;
                    Rectangle {
                        x: 0px; y: 0px; width: 3px; height: 100%;
                        border-radius: 2px;
                        background: m.status_brush;
                    }
                    row-layout := HorizontalLayout {
                        x: 14px; y: 3px;
                        width: parent.width - 28px;
                        spacing: 6px;
                        Text { width: 100px; text: m.name; font-size: 14px; vertical-alignment: center; }
                        Text { width: 80px; text: m.pid_text; font-size: 12px; color: #c8ccd4; vertical-alignment: center; }
                        Text { width: root.port-col-width; text: m.port_text; font-size: 12px; color: #c8ccd4; vertical-alignment: center; }
                        Rectangle {
                            width: 80px;
                            height: 22px;
                            y: (row-layout.height - 22px) / 2;
                            Rectangle {
                                width: st_txt.width + 25px;
                                height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: m.status_brush;
                                st_txt := Text {
                                    text: m.status_text;
                                    color: m.status_fg;
                                    font-size: 10px;
                                    x: parent.width - self.width - 7px;
                                    y: (parent.height - self.height) / 2;
                                }
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: m.status_fg;
                                    x: st_txt.x - 11px;
                                    y: (parent.height - 6px) / 2;
                                }
                            }
                        }
                        Button { text: m.action_text; width: 68px; height: 24px; enabled: m.start_enabled; clicked => { root.start_stop(idx); } }
                        Button { text: "Admin"; width: 68px; height: 24px; enabled: m.admin_enabled; clicked => { root.admin(idx); } }
                        Button { text: "Config"; width: 68px; height: 24px; clicked => { root.open_config(idx); } }
                        Button { text: "Logs"; width: 68px; height: 24px; clicked => { root.open_logs(idx); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 8px;
                    padding-bottom: 4px;
                    Text { text: "LOG"; color: #8a8f98; font-size: 10px; }
                }
                // Lines are never cut: the layout is as wide as the longest one,
                // and the view scrolls sideways (scrollbar, or Shift + wheel).
                // A plain ScrollView rather than a ListView: the log holds at
                // most MAX_LOG_LINES rows, and its layout gives the content width.
                log-list := ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-left: 10px;
                        // Room for the scrollbars, which overlay the content.
                        padding-right: 16px;
                        padding-bottom: 14px;
                        for log in logs: HorizontalLayout {
                            height: 18px;
                            padding-top: 1px;
                            spacing: 8px;
                            Text { text: log.time; color: #6f747d; font-size: 11px; font-family: "Consolas"; }
                            Text { text: "[" + log.module + "]"; color: #6aa3ff; font-size: 11px; font-family: "Consolas"; }
                            Text { text: log.text; color: log.color; font-size: 11px; font-family: "Consolas"; horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 10px;
        }
    }
}

export component ConfigWindow inherits Window {
    title: "Settings";
    width: 480px;
    height: 464px;
    icon: @image-url("../assets/logo.png");

    in-out property <string> apache-port;
    in-out property <string> apache-ssl-port;
    in-out property <string> mysql-port;
    in-out property <bool> check-ports;
    in-out property <bool> show-debug;
    in-out property <string> editor;
    in-out property <string> browser;

    callback save();
    callback cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text { text: "Ports"; color: #8a8f98; font-size: 11px; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Apache:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.apache-port; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Apache SSL:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.apache-ssl-port; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "MySQL:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.mysql-port; }
        }
        Text {
            text: "Written into the servers' own config files; restart a running server to apply.";
            color: #8a8f98;
            font-size: 11px;
        }

        Text { text: "Checks"; color: #8a8f98; font-size: 11px; }
        CheckBox { text: "Check default ports at startup"; checked <=> root.check-ports; }
        CheckBox { text: "Show debug messages in log"; checked <=> root.show-debug; }

        Text { text: "External tools"; color: #8a8f98; font-size: 11px; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Editor:"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.editor; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Browser (empty = default):"; width: 150px; vertical-alignment: center; }
            LineEdit { text <=> root.browser; }
        }

        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Cancel"; clicked => { root.cancel(); } }
            Button { text: "Save"; clicked => { root.save(); } }
        }
    }
}

export struct UpdateInfo {
    name: string,
    from-ver: string,
    targets: [string],
    sel: int,
    size: string,
    note: string,
    updatable: bool,
    restorable: bool,
    error: string,
}

// Column widths shared by the header and every row, so the columns line up
// whatever the texts are. Only DETAILS stretches (it wraps, then elides).
global UpdCols {
    out property <length> name: 92px;
    out property <length> installed: 72px;
    out property <length> target: 196px;
    out property <length> size: 56px;
    out property <length> button: 74px;
    out property <length> gap: 10px;
}

export component UpdateWindow inherits Window {
    title: "Component Updates";
    width: 820px;
    height: 430px;
    icon: @image-url("../assets/logo.png");

    in property <[UpdateInfo]> rows;
    in property <bool> busy;
    in-out property <bool> allow-major;
    in property <string> status;

    callback check-now();
    callback do-apply(int);
    callback do-restore(int);
    callback close-win();
    callback set-target(int, int);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text { text: "Component Updates"; font-size: 14px; font-weight: 600; }
        Text {
            text: "Archives only, never installers. Each swap is checksum-verified, keeps a backup, and is rolled back on failure.";
            color: #6f747d;
            font-size: 10px;
        }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                HorizontalLayout {
                    height: 28px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: UpdCols.gap;
                    Text { width: UpdCols.name; text: "COMPONENT"; color: #8a8f98; font-size: 10px; vertical-alignment: center; }
                    Text { width: UpdCols.installed; text: "INSTALLED"; color: #8a8f98; font-size: 10px; vertical-alignment: center; }
                    Text { width: UpdCols.target; text: "TARGET VERSION"; color: #8a8f98; font-size: 10px; vertical-alignment: center; }
                    Text { width: UpdCols.size; text: "SIZE"; color: #8a8f98; font-size: 10px; vertical-alignment: center; }
                    Text { min-width: 0px; horizontal-stretch: 1; text: "DETAILS"; color: #8a8f98; font-size: 10px; vertical-alignment: center; }
                    Rectangle { width: UpdCols.button * 2 + UpdCols.gap; }
                }
                Rectangle { height: 1px; background: #262932; }
                ListView {
                    for r[idx] in rows: Rectangle {
                        height: 46px;
                        // Row separator, below every row but the last.
                        Rectangle {
                            visible: idx < root.rows.length - 1;
                            x: 12px;
                            y: parent.height - 1px;
                            width: parent.width - 24px;
                            height: 1px;
                            background: #1f2229;
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: UpdCols.gap;
                            Text {
                                width: UpdCols.name;
                                text: r.name;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: UpdCols.installed;
                                text: r.from-ver;
                                font-size: 12px;
                                font-family: "Consolas";
                                color: #9aa0aa;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            // A feed error replaces target, size and details with one
                            // message that gets all of their width.
                            Rectangle {
                                min-width: 0px;
                                horizontal-stretch: 1;
                                Text {
                                    visible: r.error != "";
                                    width: parent.width;
                                    height: parent.height;
                                    text: r.error;
                                    font-size: 11px;
                                    color: #ff6b6b;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    visible: r.error == "";
                                    HorizontalLayout {
                                        spacing: UpdCols.gap;
                                        Rectangle {
                                            width: UpdCols.target;
                                            ComboBox {
                                                visible: r.updatable;
                                                y: (parent.height - self.height) / 2;
                                                width: parent.width;
                                                model: r.targets;
                                                current-index: r.sel;
                                                enabled: !root.busy;
                                                selected(v) => { root.set-target(idx, self.current-index); }
                                            }
                                            Text {
                                                visible: !r.updatable;
                                                width: parent.width;
                                                height: parent.height;
                                                text: "up to date";
                                                font-size: 12px;
                                                color: #7fbf86;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            width: UpdCols.size;
                                            text: r.size;
                                            font-size: 11px;
                                            color: #9aa0aa;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            text: r.note;
                                            font-size: 10px;
                                            color: #8a8f98;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: UpdCols.button;
                                Button {
                                    width: parent.width;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    text: "Update";
                                    enabled: r.updatable && !root.busy;
                                    clicked => { root.do-apply(idx); }
                                }
                            }
                            Rectangle {
                                width: UpdCols.button;
                                Button {
                                    width: parent.width;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    text: "Restore";
                                    enabled: r.restorable && !root.busy;
                                    clicked => { root.do-restore(idx); }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #262832;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                CheckBox { text: "Offer other release lines in the target list"; checked <=> root.allow-major; }
                Text { text: root.status; font-size: 11px; color: #9aa0aa; horizontal-stretch: 1; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Check Again"; height: 26px; enabled: !root.busy; clicked => { root.check-now(); } }
            Button { text: "Close"; height: 26px; clicked => { root.close-win(); } }
        }
    }
}

export struct FileRow {
    label: string,
    path: string,
    is-dir: bool,
    exists: bool,
}

export component FileWindow inherits Window {
    title: "RAMP Files";
    width: 520px;
    height: 380px;
    icon: @image-url("../assets/logo.png");

    in property <string> heading;
    in property <[FileRow]> rows;
    callback open-row(int);
    callback close_win();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text { text: root.heading; font-size: 14px; font-weight: 600; }
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: #33363f;
            background: #14161c;
            ListView {
                for r[idx] in rows: Rectangle {
                    height: 26px;
                    r-layout := HorizontalLayout {
                        x: 8px; y: 4px;
                        width: parent.width - 20px;
                        spacing: 8px;
                        Text {
                            text: r.is-dir ? "[DIR]" : (r.exists ? "[FILE]" : "[MISSING]");
                            width: 62px;
                            font-size: 10px;
                            font-family: "Consolas";
                            color: r.exists ? (r.is-dir ? #d8b45a : #9aa0aa) : #ff5c5c;
                        }
                        Text { text: r.label; font-size: 12px; }
                        Text { text: r.path; font-size: 10px; color: #6f747d; horizontal-stretch: 1; }
                    }
                    TouchArea {
                        clicked => { root.open-row(idx); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Click a row to open it"; color: #6f747d; font-size: 10px; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close_win(); } }
        }
    }
}



export component DepWindow inherits Window {
    title: "Missing libraries";
    width: 480px;
    height: 220px;
    icon: @image-url("../assets/logo.png");

    in property <string> headline;
    in property <string> details;
    in property <string> link-text;

    callback open_link();
    callback close_it();

    VerticalLayout {
        padding: 16px;
        spacing: 9px;
        Text { text: root.headline; font-size: 15px; font-weight: 600; }
        Text { text: root.details; wrap: word-wrap; }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            Button {
                text: "Download";
                visible: root.link-text != "";
                enabled: root.link-text != "";
                clicked => { root.open_link(); }
            }
            Button { text: "Close"; clicked => { root.close_it(); } }
        }
    }
}

export struct InstallRow {
    name: string,
    choices: [string],
    sel: int,
    note: string,
    error: string,
}

// First run: pick the version of each component before anything downloads.
export component InstallWindow inherits Window {
    title: "Install RAMP";
    width: 620px;
    height: 340px;
    icon: @image-url("../assets/logo.png");

    in property <[InstallRow]> rows;
    in property <bool> busy;
    in property <bool> ready;
    in property <string> status;
    in property <string> action-text: "Install";

    callback set-choice(int, int);
    callback action();
    callback later();

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        Text { text: "Choose what to install"; font-size: 16px; font-weight: 600; }
        Text {
            text: "Supported releases only: MariaDB's long-term support lines, the PHP branches php.net still maintains, Apache Lounge's 2.4 builds. Every archive is checksum-verified before it is installed.";
            color: #8a8f98;
            font-size: 11px;
            wrap: word-wrap;
        }
        Rectangle { height: 2px; }
        for row[idx] in root.rows: HorizontalLayout {
            spacing: 12px;
            height: 34px;
            Text { text: row.name; width: 90px; font-size: 13px; vertical-alignment: center; }
            Rectangle {
                width: 210px;
                ComboBox {
                    visible: row.choices.length > 0;
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    model: row.choices;
                    current-index: row.sel;
                    // A single candidate (phpMyAdmin) is shown, not chosen.
                    enabled: !root.busy && row.choices.length > 1;
                    selected(v) => { root.set-choice(idx, self.current-index); }
                }
            }
            Text {
                text: row.error != "" ? row.error : row.note;
                color: row.error != "" ? #ff5c5c : #9aa0aa;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status;
                color: #8a8f98;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            // Always available: a slow or unreachable feed must not trap the user.
            Button { text: "Later"; clicked => { root.later(); } }
            Button {
                text: root.action-text;
                primary: true;
                enabled: !root.busy;
                clicked => { root.action(); }
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About RAMP Control Panel";
    width: 340px;
    height: 230px;
    icon: @image-url("../assets/logo.png");

    in property <string> app-version;
    in property <string> build-type;

    callback close_it();

    VerticalLayout {
        padding: 18px;
        spacing: 7px;
        Rectangle { horizontal-stretch: 1; }
        Text { text: "RAMP Control Panel"; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
        Rectangle { height: 10px; }
        Text { text: root.app-version; horizontal-alignment: center; }
        Text { text: root.build-type; color: #8a8f98; font-size: 11px; horizontal-alignment: center; }
        Text { text: "by Loonaire"; horizontal-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            Button { text: "Close"; clicked => { root.close_it(); } }
        }
    }
}
